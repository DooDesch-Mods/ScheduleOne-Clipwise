<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Clipwise.Api - the modder-facing no-op shim for Clipwise, the clipboard item-picker organizer.
    A tiny, self-contained netstandard2.0 assembly with ZERO references (no MelonLoader, IL2CPP or Unity). A
    modder either references this DLL or drops the single Clipwise.cs file into their own project. It locates the
    running Clipwise host by reflection (Clipwise.Bridge.ClipwiseBridge) and binds standard BCL delegates - so it
    shares NO type with the host and is a true zero-overhead no-op when Clipwise is not installed. Lights up
    automatically when it is. Usage:
      Clipwise.Api.Clipboard.Category("mymod", "exotics", "Exotics").Item("haze", "mymod_haze_seed");
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Clipwise.Api</RootNamespace>
    <AssemblyName>Clipwise.Api</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

</Project>
